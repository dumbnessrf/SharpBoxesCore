<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net5.0-windows</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWPF>true</UseWPF>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>CS1591</NoWarn>
		<FileVersion>1.1.5.1</FileVersion>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageTags>csv;excel;async;tasks;reflection;validation;shapes;cache;http-helper;xml-helper;zip-helper;ini-helper;advanced-stopwatch;socket;dynamic-load-and-analyze-dll;o2html;html-serializer;chinese-pinyin;chinese-convert</PackageTags>
		<!-- 关键：构建时生成NuGet包 -->
		<Version>1.1.5.1</Version>
		<PackageIcon>Icon.png</PackageIcon>
		<IncludeReadmeFile>true</IncludeReadmeFile>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<Summary>集成常用工具方法：O2Html 对象→HTML 序列化、动态反射加载 DLL、HTTP/INI/XML/ZIP 文件操作、CSV/Excel 数据处理、汉字拼音与繁简转换、几何形状结构与计算扩展、缓存操作、ClassHelper、EventHelper、ValidationHelper、MVVM 基础、后台任务与线程池管理、TCP 通信、高级计时器等</Summary>
		<!-- 版本号 -->
		<Authors>zheng</Authors>
		<Company>Dumbnessrf</Company>
		<Description>SharpBoxesCore 是一个 .NET 工具库，提供丰富的通用方法和组件，涵盖：O2Html（对象→HTML序列化）、反射与动态加载、HTTP/INI/XML/ZIP 文件操作、CSV/Excel 数据处理、汉字拼音与繁简转换、几何形状数据结构(Point/Line/Circle等)、数据验证、MVVM 框架支持、后台任务与线程池管理、TCP 通信、高级计时器等。</Description>
		<PackageId>SharpBoxesCore</PackageId>
		<!-- 包ID -->
		<Title>SharpBoxesCore</Title>
		<requireLicenseAcceptance>true</requireLicenseAcceptance>
		<licenseUrl>https://github.com/dumbnessrf/SharpBoxesCore?tab=Apache-2.0-1-ov-file</licenseUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/dumbnessrf/SharpBoxesCore</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/dumbnessrf/SharpBoxesCore</RepositoryUrl>
		<releaseNotes>新增 O2Html 对象到HTML序列化模块；新增汉字拼音与繁简转换工具；新增 AsyncManualResetEvent 异步协调原语；重构 DataStruct 图形结构体系、拆分 ShapeExtensions；增强后台任务管理器与线程池；删除 Everything 库二进制依赖</releaseNotes>
		<copyright>Copyright（C）Zheng</copyright>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="MiniExcel" Version="1.41.3" />
		<PackageReference Include="System.ValueTuple" Version="4.5.0" />
		<PackageReference Include="System.Memory" Version="4.5.5" />
		<PackageReference Include="System.Text.Json" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.IO.Compression" Condition="'$(TargetFramework)'=='net48'" />
		<Reference Include="System.Net.Http" Condition="'$(TargetFramework)'=='net48'" />
	</ItemGroup>

	<ItemGroup>
		<None Include=".\Nuget\lib\Icon.png" Pack="true" PackagePath="\" />
		<None Include=".\Nuget\lib\readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Helpers\ChineseSpell\" />
	</ItemGroup>
</Project>
